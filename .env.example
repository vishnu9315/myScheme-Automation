# Copy this file to .env and fill in real values locally.
# .env is git-ignored — never commit real credentials.

# Base URL of the environment under test
BASE_URL=https://dev.myscheme.gov.in

# Run browsers headless (true) or headed (false)
HEADLESS=true

# --- Environment gate (ENV-01) ---
# dev.myscheme.gov.in currently sits behind an AWS Cognito Hosted UI login
# screen in front of the application itself (see BLOCKED_SCENARIOS.md ->
# ENV-01). global-setup.ts logs in once with these credentials and reuses
# the session via storageState. Leave both empty to run against an
# environment with no such gate — tests will simply fail at the gate with
# a clear screenshot/trace if one is present and these are unset.
ENV_GATE_USERNAME=
ENV_GATE_PASSWORD=

# --- DigiLocker login (unrelated to the gate above, still blocked) ---
# MyScheme's own in-app "Sign In" delegates to DigiLocker (meripehchaan.gov.in)
# via Aadhaar + OTP/PIN — there is no username/password form on the app
# itself, so these are placeholders for a future environment that exposes
# a test/staging identity provider. See BLOCKED_SCENARIOS.md (BLOCKED-01).
TEST_USERNAME=
TEST_PASSWORD=
